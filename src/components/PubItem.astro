---
import { Image } from "astro:assets";
import { resolveHref } from "../utils.js";

// One publication: venue tag, authors, title, venue, then link buttons. The
// thumbnail column only exists when `image` is set.
const { tag, authors, title, venue, image, links = [] } = Astro.props;
---

<article class:list={["pub", image && "has-image"]}>
  {
    image && (
      <figure class="pub-figure">
        <Image
          src={image}
          alt={`${title} — figure`}
          widths={[200, 400, 600]}
          sizes="(max-width: 900px) 100vw, 200px"
          loading="lazy"
        />
      </figure>
    )
  }
  <div class="pub-body">
    <p class="pub-text">
      {tag && <span class="pub-tag">[{tag}]</span>}{" "}
      <span set:html={authors} />{" "}
      <strong class="pub-title">{title}</strong>{" "}
      <span set:html={venue} />
    </p>
    {
      links.length > 0 && (
        <div class="actions">
          {links.map((l) => (
            <a
              class="pill"
              href={resolveHref(l.href)}
              target="_blank"
              rel="noopener noreferrer"
            >
              {l.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
