---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Section from "../components/Section.astro";
import Project from "../components/Project.astro";
import PubItem from "../components/PubItem.astro";
import DemoNotice from "../components/DemoNotice.astro";
import { site, absoluteUrl } from "../site.config.js";
import {
  profile,
  sections,
  bio,
  news,
  projects,
  publications,
  publicationGroups,
  skills,
  teaching,
  mentoring,
  more,
  lastUpdated,
} from "../data.js";

const title = `${profile.nameEn} — ${profile.role}`;
const label = Object.fromEntries(sections.map((s) => [s.id, s.label]));

// Structured data, assembled from the same content the page renders.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.nameEn,
  url: absoluteUrl("/"),
  jobTitle: site.seo.jobTitle,
  description: site.description,
  email: `mailto:${profile.email}`,
  ...(site.seo.affiliation && {
    affiliation: { "@type": "CollegeOrUniversity", ...site.seo.affiliation },
  }),
  knowsAbout: site.seo.knowsAbout,
  sameAs: [profile.scholar, profile.github],
};
---

<Base title={title} path="/" jsonLd={jsonLd}>
  {site.demoNotice && <DemoNotice repo={site.repo} />}

  <a class="skip" href="#main">Skip to content</a>
  <Sidebar />

  {/* One continuous page. The sections, their order and the sidebar links
      all come from `sections` in src/data.js. */}
  <main id="main">
    <Section id="bio" title={label.bio}>
      <div class="prose">
        {bio.map((para) => <p set:html={para} />)}
      </div>
    </Section>

    <Section id="news" title={label.news}>
      <ul class="news">
        {
          news.map((n) => (
            <li>
              <span class="news-date">[{n.date}]</span>{" "}
              <span set:html={n.text} />
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="projects" title={label.projects}>
      <div class="projects">
        {projects.map((p) => <Project {...p} />)}
      </div>
    </Section>

    <Section id="publications" title={label.publications}>
      {
        publicationGroups.map((g) => (
          <>
            <h3 class="pub-group">{g.title}</h3>
            <div class="pubs">
              {publications
                .filter((p) => p.type === g.type)
                .map((p) => (
                  <PubItem {...p} />
                ))}
            </div>
          </>
        ))
      }
    </Section>

    <Section id="skills" title={label.skills}>
      <dl class="skills">
        {
          skills.map((g) => (
            <div class="skill-group">
              <dt>{g.label}</dt>
              <dd>
                <ul>
                  {g.items.map((item) => <li>{item}</li>)}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <Section id="teaching" title={label.teaching}>
      <ul class="teaching">
        {
          teaching.map((t) => (
            <li>
              <span class="teaching-date">[{t.date}]</span>{" "}
              Graduate Teaching Assistant, {t.course} · Virginia Tech
            </li>
          ))
        }
      </ul>
      <div class="more-group mentoring">
        <h3>{mentoring.title}</h3>
        {mentoring.text.map((t) => <p set:html={t} />)}
        {
          mentoring.images.length > 0 && (
            <ul class="gallery">
              {mentoring.images.map((img, i) => (
                <li>
                  <Image
                    src={img}
                    alt={`${mentoring.title} photo ${i + 1}`}
                    widths={[320, 640, 960]}
                    sizes="(max-width: 900px) 50vw, 400px"
                    loading="lazy"
                  />
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </Section>

    <Section id="more" title={label.more}>
      <div class="more">
        {
          more.map((g) => (
            <div class="more-group">
              <h3>{g.title}</h3>
              {g.text.map((t) => <p set:html={t} />)}
              {g.images.length > 0 && (
                <ul class="gallery">
                  {g.images.map((img, i) => (
                    <li>
                      <Image
                        src={img}
                        alt={`${g.title} photo ${i + 1}`}
                        widths={[320, 640, 960]}
                        sizes="(max-width: 900px) 50vw, 280px"
                        loading="lazy"
                      />
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </Section>

    <footer>Last updated {lastUpdated}</footer>
  </main>
</Base>
