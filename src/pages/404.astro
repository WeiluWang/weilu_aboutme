---
// GitHub Pages serves this for any URL that does not exist.
import Base from "../layouts/Base.astro";
import { profile } from "../data.js";

const home = import.meta.env.BASE_URL;
---

<Base title={`Not found — ${profile.nameEn}`} path="/404" noindex>
  <main class="not-found">
    <section>
      <h2>Page not found</h2>
      <p>
        That address does not exist here. <a href={home}>Back to the homepage</a
        >.
      </p>
    </section>
  </main>
</Base>

<style>
  /* No sidebar on this page, so the column starts at the left edge. */
  .not-found {
    margin-left: 0;
  }
</style>
